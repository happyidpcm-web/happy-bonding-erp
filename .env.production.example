# Happy Bonding ERP - Production Environment Configuration

# Database Connection (Docker container service name: postgres)
POSTGRES_USER=happybonding
POSTGRES_PASSWORD=replace_with_strong_password_here
POSTGRES_DB=happybonding_erp
DATABASE_URL=postgresql://happybonding:replace_with_strong_password_here@postgres:5432/happybonding_erp?schema=public

# JWT Auth Secret (Generate a strong random 64-char string)
JWT_SECRET=replace_with_strong_random_jwt_secret_key_2026

# Server Port
PORT=4000
NODE_ENV=production
