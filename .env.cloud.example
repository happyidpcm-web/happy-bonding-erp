# Neon PostgreSQL Database URL (Replace with your actual Neon.tech connection string)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require"

# JWT Auth Secret (Generate any random secure string)
JWT_SECRET="HappyBondingERP_Cloud_Secret_Key_2026_Secure"

# Node Environment
NODE_ENV="production"

# Port (Render sets this automatically)
PORT=10000

